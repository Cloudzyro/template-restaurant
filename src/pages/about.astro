---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Art from "../components/Art.astro";
import { about, site } from "../data/site";
---

<Base title="About" description={`${about.chefName} and the story of ${site.name}.`}>
  <PageHero eyebrow="Our story" title={about.title} />
  <section class="section">
    <div class="wrap about-grid">
      <figure class="portrait">
        <svg viewBox="0 0 400 480" role="img" aria-label={`Illustrated portrait placeholder of ${about.chefName}`}>
          <rect width="400" height="480" rx="200" fill="#56633a"></rect>
          <circle cx="200" cy="190" r="70" fill="#e9c9a5"></circle>
          <rect x="128" y="120" width="144" height="40" rx="20" fill="#fbf7f0"></rect>
          <path d="M130 160c0-60 140-60 140 0-30-16-110-16-140 0z" fill="#fbf7f0"></path>
          <path d="M80 480c10-110 70-170 120-170s110 60 120 170z" fill="#fbf7f0"></path>
        </svg>
        <figcaption><strong>{about.chefName}</strong><br />{about.chefRole}</figcaption>
      </figure>
      <div class="story">
        <blockquote>{about.quote}</blockquote>
        {about.paragraphs.map((p) => <p>{p}</p>)}
        <p>
          When you visit, ask for a seat at the counter. It's the best view of the fire, and Renata will probably hand you
          something to taste.
        </p>
        <a class="btn btn-primary" href={site.reservationUrl}>{site.reservationLabel}</a>
      </div>
    </div>
  </section>
  <section class="section strip">
    <div class="wrap strip-grid">
      <figure><Art kind="leaf" label="Illustration of herbs from the garden" /></figure>
      <figure><Art kind="flame" label="Illustration of the wood-fired hearth" /></figure>
      <figure><Art kind="bread" label="Illustration of a loaf from the wood oven" /></figure>
    </div>
  </section>
</Base>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(32px, 6vw, 80px);
    align-items: start;
  }
  .portrait {
    margin: 0;
    max-width: 380px;
  }
  figcaption {
    margin-top: 1rem;
    color: var(--muted);
  }
  figcaption strong {
    color: var(--ink);
  }
  blockquote {
    margin: 0 0 1.5rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.5rem, 3vw, 2.1rem);
    line-height: 1.3;
    color: var(--olive);
  }
  .story p {
    max-width: 62ch;
  }
  .strip {
    padding-top: 0;
  }
  .strip-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 16px;
  }
  .strip-grid figure {
    margin: 0;
    border-radius: var(--radius);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    display: flex;
  }
  @media (max-width: 760px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
    .portrait {
      max-width: 260px;
    }
  }
</style>
