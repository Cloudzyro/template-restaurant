---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import InquiryForm from "../components/InquiryForm.astro";
import { events, site } from "../data/site";
---

<Base title="Private events" description={`Private dining, celebrations and full buyouts at ${site.name}.`}>
  <PageHero eyebrow="Gather with us" title={events.title} text={events.text} />
  <section class="section">
    <div class="wrap events-grid">
      <div>
        <h2>What we offer</h2>
        <ul class="points">
          {events.points.map((p) => <li>{p}</li>)}
        </ul>
        <p class="contact">
          Prefer to talk it through? Call us at{" "}
          <a href={`tel:${site.phone.replace(/[^\d+]/g, "")}`}>{site.phone}</a>.
        </p>
      </div>
      <div>
        <h2 class="visually-hidden">Send an inquiry</h2>
        <InquiryForm />
      </div>
    </div>
  </section>
</Base>

<style>
  .events-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(32px, 6vw, 72px);
    align-items: start;
  }
  .points {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem;
    display: grid;
    gap: 1rem;
  }
  .points li {
    padding-left: 2rem;
    position: relative;
    font-weight: 600;
  }
  .points li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.45em;
    width: 14px;
    height: 14px;
    border-radius: 50% 50% 50% 0;
    background: var(--ember);
    transform: rotate(-45deg);
  }
  .contact {
    color: var(--muted);
  }
  @media (max-width: 860px) {
    .events-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
