---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import HoursTable from "../components/HoursTable.astro";
import HoursToday from "../components/HoursToday.astro";
import { site } from "../data/site";

const fullAddress = `${site.address.street}, ${site.address.city}, ${site.address.region} ${site.address.postal}`;
---

<Base title="Visit" description={`Hours, directions and parking for ${site.name}, ${fullAddress}.`}>
  <PageHero eyebrow="Location and hours" title="Come sit by the fire">
    <div class="status"><HoursToday /></div>
  </PageHero>
  <section class="section">
    <div class="wrap visit-grid">
      <div class="card">
        <h2>Where we are</h2>
        <address>
          {site.address.street}<br />
          {site.address.city}, {site.address.region} {site.address.postal}
        </address>
        <p>
          <a href={`tel:${site.phone.replace(/[^\d+]/g, "")}`}>{site.phone}</a><br />
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
        <a class="btn btn-primary" href={site.mapsUrl}>Open in maps</a>
        <h3>Getting here</h3>
        <ul class="tips">
          <li>Free street parking on Wren Street after 5pm, and a public lot one block east on Mill Avenue.</li>
          <li>The Riverton Line stops at Wren and 4th, a two-minute walk.</li>
          <li>Step-free entrance and an accessible restroom on the main floor.</li>
        </ul>
      </div>
      <div class="card">
        <h2>Opening hours</h2>
        <HoursTable />
        <p class="small">Holiday hours may vary. We post changes here first.</p>
      </div>
    </div>
  </section>
  <section class="section map-section" aria-label="Map">
    <div class="wrap">
      <a class="map" href={site.mapsUrl}>
        <svg viewBox="0 0 1000 360" role="img" aria-label={`Stylized map showing ${site.name} at ${fullAddress}. Opens in your maps app.`} preserveAspectRatio="xMidYMid slice">
          <rect width="1000" height="360" fill="#e9dccb"></rect>
          <path d="M0 250C200 220 300 300 520 260S860 160 1000 190V360H0z" fill="#c9d3b0"></path>
          <g stroke="#fbf7f0" stroke-width="18" fill="none">
            <path d="M0 120H1000"></path>
            <path d="M420 0V360"></path>
            <path d="M0 300L1000 60" stroke-width="12"></path>
            <path d="M760 0V360" stroke-width="12"></path>
          </g>
          <g transform="translate(420 120)">
            <circle r="34" fill="#a8401a" opacity=".2"></circle>
            <path d="M0-40c-16 0-28 12-28 27 0 20 28 47 28 47s28-27 28-47c0-15-12-27-28-27z" fill="#a8401a"></path>
            <circle cy="-14" r="10" fill="#fff"></circle>
          </g>
        </svg>
        <span class="map-label">Open in maps</span>
      </a>
    </div>
  </section>
</Base>

<style>
  .status {
    margin-top: 1rem;
  }
  .visit-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 24px;
  }
  .card {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: clamp(24px, 4vw, 40px);
  }
  address {
    font-style: normal;
    font-size: 1.2rem;
    margin-bottom: 0.75rem;
  }
  h3 {
    margin-top: 2rem;
  }
  .tips {
    padding-left: 1.2rem;
    margin: 0;
    display: grid;
    gap: 0.5rem;
  }
  .small {
    margin-top: 1rem;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .map-section {
    padding-top: 0;
  }
  .map {
    display: block;
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line);
  }
  .map svg {
    width: 100%;
    height: auto;
    min-height: 220px;
  }
  .map-label {
    position: absolute;
    right: 16px;
    bottom: 16px;
    background: var(--ink);
    color: #fff;
    font-weight: 600;
    padding: 0.5rem 0.75rem;
    border-radius: 8px;
  }
</style>
