---
import { site, hours } from "../data/site";
import { describeDay } from "../lib/hours";
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap grid">
    <div>
      <p class="name">{site.name}</p>
      <p>{site.tagline}.</p>
      <a class="btn btn-light" href={site.reservationUrl}>{site.reservationLabel}</a>
    </div>
    <div>
      <h2>Find us</h2>
      <address>
        {site.address.street}<br />
        {site.address.city}, {site.address.region} {site.address.postal}
      </address>
      <p>
        <a href={`tel:${site.phone.replace(/[^\d+]/g, "")}`}>{site.phone}</a><br />
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </div>
    <div>
      <h2>Hours</h2>
      <ul class="hours">
        {
          hours.map((d) => (
            <li>
              <span>{d.name.slice(0, 3)}</span>
              <span>{describeDay(d)}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <div class="wrap legal">
    <p>&copy; {year} {site.name}</p>
    <ul>
      {site.social.map((s) => <li><a href={s.url}>{s.label}</a></li>)}
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--night);
    color: #e9dccb;
    padding-block: 72px 32px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 2.5rem;
  }
  .name {
    font-family: var(--font-display);
    font-size: 2rem;
    color: #fff;
    margin-bottom: 0.25rem;
  }
  h2 {
    font-family: var(--font-body);
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold);
  }
  address {
    font-style: normal;
    margin-bottom: 1rem;
  }
  a:not(.btn) {
    color: #fff;
  }
  .hours {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.95rem;
  }
  .hours li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.3rem 0;
    border-bottom: 1px solid rgb(255 255 255 / 0.1);
  }
  .hours li span:last-child {
    text-align: right;
  }
  .legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid rgb(255 255 255 / 0.12);
    font-size: 0.9rem;
    color: #bfae99;
  }
  .legal p {
    margin: 0;
  }
  .legal ul {
    display: flex;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
</style>
